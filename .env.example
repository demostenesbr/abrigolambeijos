POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=abrigolambeijos
DATABASE_URL=postgresql://postgres:postgres@db:5432/abrigolambeijos
PORT=3001

# URLs acessíveis pelo navegador (não usar hostnames internos do Docker aqui)
NEXT_PUBLIC_API_URL=http://localhost:3001
VITE_API_URL=http://localhost:3001

# Origens permitidas no CORS do backend (frontend Next.js e admin Vite)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Autenticação (trocar em produção)
JWT_SECRET=dev-only-change-me-abrigolambeijos
JWT_EXPIRES_IN=1d
